-45fa-4bf5-92c4-ad96ba31d4ef"}]}}},{"path":"versions/494fbbbb-d7c5-4cf1-9a11-c6a3833d74aa/d8131e9a7f9d5a521137759f65c147aaf1dafc4cf504da801188f5f6932391de.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"494fbbbb-d7c5-4cf1-9a11-c6a3833d74aa","revision":"sha256:d8131e9a7f9d5a521137759f65c147aaf1dafc4cf504da801188f5f6932391de","kind":"mcqs","content":{"question":[{"type":"text","content":"Consider the following splay tree. Perform Find(20), followed by Find(50). After each Find, splay the accessed node to the root using the standard bottom-up splaying procedure. Which statement about the final tree is FALSE?"},{"type":"image","src":"../../assets/3a3a5dbd0c46ca3c431f82ff3760e239b940a01d0950bbac44b53204a688982d.png","alt":"image.png"}],"options":[{"type":"text","content":"50 is the root.","correct":false,"option_id":"dc32d8f2-2ad1-41da-a801-19be0a4ebf78"},{"type":"text","content":"40 is the right child of 50.","correct":true,"option_id":"79dfb71d-ac42-4237-9fe7-7d0afbf1e673"},{"type":"text","content":"30 is the left child of 40.","correct":false,"option_id":"b7063bee-301f-453b-863b-05aa88766f47"},{"type":"text","content":"10 is the left child of 20.","correct":false,"option_id":"2becc828-9043-4812-87c2-9b7260f7ee33"}]}}},{"path":"versions/112b3357-8902-47d4-89c4-a3b471bc22a7/fe862facd7da97180e128f974f017b37e80332940d3b0eb6b79c5278e0d6cb56.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"112b3357-8902-47d4-89c4-a3b471bc22a7","revision":"sha256:fe862facd7da97180e128f974f017b37e80332940d3b0eb6b79c5278e0d6cb56","kind":"mcqs","content":{"question":[{"type":"text","content":"An initially empty dynamic array has capacity 1. Immediately before each insertion, if its current size equals its capacity, the capacity is tripled and all existing elements are copied to the new array. No resizing is performed merely because an insertion has filled the array.\nEach insertion costs 1, and copying each existing element costs an additional 1. All other costs are ignored. What is the total cost of inserting 9 elements?"}],"options":[{"type":"text","content":"12","correct":false,"option_id":"197646ce-a35f-4db2-8959-4da86319543f"},{"type":"text","content":"13","correct":true,"option_id":"4b52c69d-c9e4-4aca-93bb-f3d154cad6b0"},{"type":"text","content":"18","correct":false,"option_id":"a015df36-ffcc-49f3-a4fb-d627ce4095ab"},{"type":"text","content":"22","correct":false,"option_id":"620b3bbf-c511-487c-8a58-37682b7a568b"}]}}},{"path":"versions/f38ca6af-3d02-4d8b-bd01-02ff30ff62d8/353571ec1c7516720da93624812bbd9828cd91f7f3840159378eda33cc20315a.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"f38ca6af-3d02-4d8b-bd01-02ff30ff62d8","revision":"sha256:353571ec1c7516720da93624812bbd9828cd91f7f3840159378eda33cc20315a","kind":"mcqs","content":{"question":[{"type":"text","content":"In the red-black tree obtained by successively inserting the keys 19, 41, 67, 28, 53, 12, 7 into an initially empty red-black tree, which statement is FALSE?"}],"options":[{"type":"text","content":"41 is the root.","correct":false,"option_id":"cf4475d8-bce7-465e-9ba4-b6a4645f35b2"},{"type":"text","content":"19 and 67 are siblings, and both are black.","correct":true,"option_id":"f1e04b89-eb78-4fa6-8747-e4a9a8e1ed9a"},{"type":"text","content":"12 and 28 are siblings.","correct":false,"option_id":"3dad7d0d-ac76-4841-9543-b5000754fe5a"},{"type":"text","content":"7 is red.","correct":false,"option_id":"4725a656-1776-47f7-aec2-69a77e808b26"}]}}},{"path":"versions/61e64860-6add-4f6c-9ec9-09de4dc63ad2/4c0caa6ef82300747ec1dfde0f07a3943d7f37c30ed09166e312e051ea5e8165.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"61e64860-6add-4f6c-9ec9-09de4dc63ad2","revision":"sha256:4c0caa6ef82300747ec1dfde0f07a3943d7f37c30ed09166e312e051ea5e8165","kind":"mcqs","content":{"question":[{"type":"text","content":"Consider the 3-order B+ tree given in the figure, after inserting 65 and then deleting 50, which statement is FALSE? (The height of an empty tree is defined to be −1, and the height of a single-node tree is 0.)"},{"type":"image","src":"../../assets/aadcb43a70467bad64c6900beb14de451857ab467c80f4d82a3a0bae96001350.png","alt":"image.png"}],"options":[{"type":"text","content":"The root contains the keys [30, 60].","correct":true,"option_id":"726edd21-2f0f-491f-b539-75909ae9e367"},{"type":"text","content":"The leftmost leaf contains [10, 20].","correct":false,"option_id":"aa04583b-344a-4834-bfb9-7d9e3749892e"},{"type":"text","content":"Keys 30 and 40 are in the same leaf node.","correct":false,"option_id":"18f04717-46c3-4cb8-9418-407737185bf1"},{"type":"text","content":"The height of the tree is 2.","correct":false,"option_id":"6e9fce29-d1de-4662-9c42-15d3804c71d1"}]}}},{"path":"versions/58839f31-fe26-43c9-9ec5-6cdc18bfbe99/b62f8727af9c3dc4ad7e9caf2e5a6a572ea77bd416741fae62e9fb274bd7950c.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"58839f31-fe26-43c9-9ec5-6cdc18bfbe99","revision":"sha256:b62f8727af9c3dc4ad7e9caf2e5a6a572ea77bd416741fae62e9fb274bd7950c","kind":"mcqs","content":{"question":[{"type":"text","content":"Consider the following game tree. Assuming that nodes are evaluated from left to right, how many leaf nodes can be pruned by α-β pruning algorithm?"},{"type":"image","src":"../../assets/143eee7ace9c0d9e0338a1167b6ffa45a8e457faa5e69c95b1324e75c4896b9a.png"}],"options":[{"type":"text","content":"0","correct":false,"option_id":"a6392ad3-f36e-4d4d-8307-6304fb9d3b41"},{"type":"text","content":"1","correct":false,"option_id":"58d6496e-d1d1-483f-8e76-06a8b4c3348a"},{"type":"text","content":"2","correct":true,"option_id":"b004e1b1-f2cb-443f-b7e9-5caa31dbc61c"},{"type":"text","content":"3","correct":false,"option_id":"b74b3384-470a-4f80-ba4c-8ddbaaf2f83f"}]}}},{"path":"versions/7bac33db-c037-4eff-aba4-33e9dce4246f/dcd08b409b00840b0f912e2ac0a89fab8d87a27d1c58183bfad9fa4ae8344844.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"7bac33db-c037-4eff-aba4-33e9dce4246f","revision":"sha256:dcd08b409b00840b0f912e2ac0a89fab8d87a27d1c58183bfad9fa4ae8344844","kind":"mcqs","content":{"question":[{"type":"text","content":"Given a $4\\times6$ grid, where each cell contains an integer weight as shown in the figure. Starting from the top-left cell $(1,1)$, you can only move right or down until reaching the bottom-right cell $(4,6)$.\nWhat is the maximum possible sum of weights along a valid path, including both the starting and ending cells?"},{"type":"image","src":"../../assets/41f367826aa51151fd531da66cbc05e55259814898e6ef81e76c0026422dc463.png"}],"options":[{"type":"text","content":"37","correct":false,"option_id":"3bc9828f-6cf3-43c9-8369-a46ba7acfcad"},{"type":"text","content":"39","correct":false,"option_id":"ba20dd2b-cd77-4b7c-b8de-cbf566ad68b0"},{"type":"text","content":"40","correct":true,"option_id":"00d67ce7-81b7-4708-b1a0-9a3aca780dc5"},{"type":"text","content":"43","correct":false,"option_id":"d36eaf19-0421-4572-9112-3ed5efeddc14"}]}}},{"path":"versions/7929ffa0-c309-4b70-ae4f-5d3601b9e6a0/fe05a469aa9daee3f80bbd1377ab0ad39b3ac67f5c2f9853003c86da72d24150.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"7929ffa0-c309-4b70-ae4f-5d3601b9e6a0","revision":"sha256:fe05a469aa9daee3f80bbd1377ab0ad39b3ac67f5c2f9853003c86da72d24150","kind":"mcqs","content":{"question":[{"type":"text","content":"Which of the following statements about Skew Heap is correct?"}],"options":[{"type":"text","content":"All operations (Merge, Insert, and DeleteMin) have a strict worst-case time complexity of $O(\\log N)$ because the Null Path Length (NPL) property is strictly maintained.","correct":false,"option_id":"a76f6bd9-aac7-44f7-9886-51f4b794412c"},{"type":"text","content":"The worst-case time complexity for a single Merge or DeleteMin operation can be $O(N)$, but its amortized time complexity is $O(\\log N)$ per operation.","correct":true,"option_id":"6a1fc5ce-3e9e-4f9a-a100-c895b830cb7d"},{"type":"text","content":"The worst-case time complexity for Insert is $O(\\log N)$ and for DeleteMin is $O(N)$.","correct":false,"option_id":"ce28e14d-0e44-4ec5-9e97-c5f5ab6d86b0"},{"type":"text","content":"Skew heaps guarantee $O(\\log N)$ worst-case time complexity for the Merge operation.","correct":false,"option_id":"7d5026a2-2378-4b60-b93f-bcf47c364850"}]}}},{"path":"versions/f6aa8d22-66eb-44d0-b06e-a8406b44ab4b/f49f5aa45681bb3871d6a3b1513d396310127c1c299e47887522016fb0d64450.json","value":{"schema_version":1,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"f6aa8d22-66eb-44d0-b06e-a8406b44ab4b","revision":"sha256:f49f5aa45681bb3871d6a3b1513d396310127c1c299e47887522016fb0d64450","kind":"mcqs","content":{"question":[{"type":"text","content":"In a binomial queue with 125 nodes, how many nodes have 2 children?"}],"options":[{"type":"text","content":"13","correct":false,"option_id":"79d4e74d-ab98-49d6-8616-e8e17e2179a3"},{"type":"text","content":"14","correct":false,"option_id":"d7854d15-ad74-4bc3-b34f-a12fb0e5deda"},{"type":"text","content":"15","correct":false,"option_id":"3bb5310e-a49b-461b-88b1-e507a0515e50"},{"type":"text","content":"16","correct":true,"option_id":"f9117a36-7d5e-466c-bde0-b2667b8dafc1"}]}}},{"path":"versions/eb7f0324-cf27-4d16-8e7f-84cd866e71c6/6dfe3003bedacd7412b6cf52de4d9f913f05ed5aa0423ec4284f0395bc598983.json","value":{"schema_version":3,"revision_scheme":"holly-question-v1","bank_id":"3eb3811b-4425-46ad-8bb6-a0504dca151b","question_id":"eb7f0324-cf27-4d16-8